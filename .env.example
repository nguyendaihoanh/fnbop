# ==============================================================================
# WFM - F&B WORKFORCE MANAGEMENT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Song ngữ / Bilingual: Tiếng Việt (VI) & English (EN)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CHẾ ĐỘ VẬN HÀNH / SYSTEM RUNTIME MODE
# ------------------------------------------------------------------------------
# VI: Chế độ On-Premise chạy hoàn toàn cục bộ, không phụ thuộc n8n hay Google Sheets.
# EN: On-premise mode runs 100% locally with zero dependency on n8n or Google Sheets.
ON_PREMISE_MODE=true

# VI: Cổng dịch vụ Web PWA cho chủ quán & nhân viên truy cập.
# EN: Frontend PWA web port accessible by store owner and staff.
PORT=8100

# VI: Cổng FastAPI Backend lõi.
# EN: Core FastAPI Backend port.
BACKEND_PORT=8100

# VI: Cổng Zalo Gateway Microservice.
# EN: Zalo Gateway Microservice port.
ZALO_GATEWAY_PORT=8177

# VI: Địa chỉ bind mạng (0.0.0.0 cho phép truy cập qua LAN từ điện thoại/máy POS).
# EN: Network bind address (0.0.0.0 allows LAN access from mobile phones/POS).
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. BẢO MẬT & PHÂN QUYỀN / SECURITY & CREDENTIALS
# ------------------------------------------------------------------------------
# VI: Khóa bí mật JWT dùng để ký token phiên đăng nhập (tối thiểu 32 ký tự ngẫu nhiên).
# EN: JWT secret key used to sign authentication tokens (minimum 32 random characters).
JWT_SECRET_KEY=change_this_to_a_random_32_character_secret_key_in_production

# VI: Mật khẩu quản trị viên (Admin/Chủ quán). Hãy thay đổi khi triển khai thực tế!
# EN: Admin / Owner master password. Change this upon real deployment!
ADMIN_PASSWORD=change_this_to_a_strong_admin_password

# VI: Mật khẩu mặc định cho nhân sự mới trước khi đổi mã PIN 4 số.
# EN: Default password for new staff members before setting their 4-digit PIN.
STAFF_PASSWORD=change_this_to_default_staff_pin

# VI: Khóa bí mật giao tiếp máy POS / Webhook nội bộ.
# EN: Secret key for POS integration and internal webhooks.
POS_SECRET=change_this_to_your_pos_secret_key

# ------------------------------------------------------------------------------
# 3. KÊNH THÔNG BÁO DUAL-CHANNEL / TELEGRAM & ZALO
# ------------------------------------------------------------------------------
# VI: Telegram Bot Token chính thức - CHỈ DÙNG gửi báo cáo cuối ca / bảng lương chốt.
# EN: Production Telegram Bot Token - EXCLUSIVE for final shift closing & approved payroll.
PROD_TELEGRAM_BOT_TOKEN=your_production_telegram_bot_token

# VI: Telegram Bot Dev/Test - Dùng cho cảnh báo thử nghiệm, debug, webhook test.
# EN: Dev/Test Telegram Bot Token - Used for debug, testing, and dev alerts.
TELEGRAM_BOT_TOKEN=your_dev_telegram_bot_token
TEST_TELEGRAM_BOT_TOKEN=your_dev_telegram_bot_token

# VI: Chat ID Telegram nhận thông báo vận hành quán.
# EN: Telegram Chat ID receiving operational store alerts.
TELEGRAM_CHAT_ID=your_telegram_chat_id

# VI: URL nội bộ kết nối tới Zalo Gateway microservice.
# EN: Internal URL connecting to Zalo Gateway microservice.
ZALO_GATEWAY_URL=http://zalo-gateway:8177

# VI: Thư mục lưu trữ phiên đăng nhập Zalo (mount bền vững).
# EN: Directory for persistent Zalo login sessions (mounted volume).
ZALO_SESSION_DIR=data/zalo_session

# ------------------------------------------------------------------------------
# 4. ĐƯỜNG DẪN DỮ LIỆU CSDL / DATABASE & STORAGE PATHS
# ------------------------------------------------------------------------------
# VI: Thư mục gốc chứa toàn bộ dữ liệu SQLite, PDF và JSON.
# EN: Root data directory containing SQLite DB, PDFs, and JSON files.
DATA_DIR=data

# VI: Tệp CSDL SQLite chế độ WAL siêu bền vững, chống hỏng hóc khi mất điện.
# EN: SQLite database file running in WAL mode, crash-safe during power outages.
DATABASE_PATH=data/fnbop.db

# VI: Các tệp lưu trữ bổ trợ (Đã chuyển đổi hoàn toàn sang SQLite fnbop.db làm Single Source of Truth).
# EN: Auxiliary JSON storage files (Deprecated: fully unified into SQLite fnbop.db Single Source of Truth).
# DATA_FILE=data/data.json
# AUTH_FILE=data/staff_auth.json
# APPROVALS_FILE=data/shift_approvals.json
# ROSTER_FILE=data/roster_schedule.json
# EVALUATIONS_FILE=data/eval_logs.json

# ------------------------------------------------------------------------------
# 5. THIẾT LẬP QUÁN & ĐỊNH BIÊN CA / STORE & SHIFT CONFIGURATION
# ------------------------------------------------------------------------------
# VI: Tên quán hiển thị trên tiêu đề bảng lương và phiếu in nhiệt.
# EN: Store brand name displayed on payroll headers and thermal receipt printouts.
STORE_NAME=WFM Coffee & Lounge

# VI: Mã định danh quán (dùng trong mô hình chuỗi nhiều quán).
# EN: Unique store identifier (used in multi-outlet branch deployments).
STORE_CODE=WFM01

# VI: Chế độ đối soát POS ('manual' = nhập tay thu ngân, 'pos365' = tự động kéo POS365).
# EN: POS reconciliation mode ('manual' = cashier input, 'pos365' = POS365 API sync).
POS_MODE=manual

# VI: Số giờ tự động đóng ca sau giờ tan ca nếu nhân viên quên dập thẻ (mặc định: 2 tiếng).
# EN: Hours after shift end to auto-close forgotten checkouts (default: 2 hours).
AUTO_CLOSE_HOURS=2

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH GỬI EMAIL PHIẾU LƯƠNG / SMTP OUTBOX PATTERN
# ------------------------------------------------------------------------------
# VI: Bật gửi email qua SMTP thật (nếu 'false', phiếu PDF sẽ lưu vào Outbox cục bộ).
# EN: Enable live SMTP email dispatch (if 'false', payslip PDFs are saved to local Outbox).
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="WFM Workforce Management"

# ------------------------------------------------------------------------------
# 7. QUẢN LÝ TÀI NGUYÊN CONTAINER / DOCKER RESOURCE BUDGET
# ------------------------------------------------------------------------------
# VI: Tổng ngân sách RAM cho toàn bộ 3 container: Nginx (40M) + Backend (150M) + Zalo (60M) = 250MB.
# EN: Total container RAM budget: Nginx (40M) + Backend (150M) + Zalo (60M) = 250MB.
MEM_LIMIT_TOTAL=250M
